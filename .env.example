# Database (SQLite file lives at prisma/dev.db)
DATABASE_URL="file:./dev.db"

# AI provider: openai | anthropic | mock
# "mock" (or no key) uses deterministic, template-based fallbacks; the whole demo works offline.
AI_PROVIDER="mock"

# Optional: override the chat model (defaults: gpt-4o-mini for openai, claude-sonnet-4-5 for anthropic)
AI_MODEL=""

OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Set to "1" to generate flyer art with the OpenAI image model (needs OPENAI_API_KEY). Otherwise a CSS gradient flyer is used.
AI_IMAGES="0"

# Embeddings: auto | openai | local. "auto" = OpenAI text-embedding-3-small when OPENAI_API_KEY is set,
# otherwise the local hashed TF-IDF vectorizer (lib/ai/localEmbed.ts). Mixed vector sizes are handled
# automatically, but re-run the seed after switching for the best ranking quality.
EMBEDDINGS_PROVIDER="auto"

# Signs student session cookies. Change this to any long random string.
AUTH_SECRET="trojanengage-dev-secret-change-me"
